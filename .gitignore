Data/*.txt

# Rotating app logs (Phase 6, see Backend/logging_config.py)
Data/logs/

# VS Code temp files
**/tempCodeRunnerFile.py

# Diagnostic/test scripts
diagnose.py
test_mic.py

# OS files
.DS_Store
Thumbs.db

# IDE settings
.vscode/
.idea/
